<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      权限策略（隐私红线不变：无 INTERNET / 存储 / 位置，所有识别与点击均在本地完成）：
      - RECEIVE_BOOT_COMPLETED / POST_NOTIFICATIONS：保活——开机恢复 + 掉线本地提醒，不读任何数据；
      - WRITE_SECURE_SETTINGS：signature 级权限，正常安装拿不到、必须电脑 adb 手动授予，
        仅用于把本 App 自己的无障碍服务写回系统设置（静默复活），属用户显式授权的运营性权限。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      包可见性（Android 11+）：排行榜/最近记录要用 PackageManager 查其他 App 的
      图标与名称，findHomePackages 要查桌面，targetSdk 34 下不声明就是查不到
      （必然抛 NameNotFoundException，回退成包名 + 灰图标）。
      按 LAUNCHER / HOME 两类 intent 收窄声明，不申请 QUERY_ALL_PACKAGES。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- allowBackup=false：规则与统计全在应用私有目录，不参与系统备份/换机迁移。
         lint 的 DataExtractionRules 是给「开着备份」的应用准备的配置入口，这里是关着的，
         没有可配置的内容；用户要迁移用自己的「备份规则」导出 zip。 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Daxiaojie"
        tools:ignore="DataExtractionRules,AllowBackup">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.RecentActivity" android:exported="false" />
        <activity android:name=".ui.RulesActivity" android:exported="false" />
        <activity android:name=".ui.SnapshotDetailActivity" android:exported="false" />
        <activity android:name=".ui.KeepAliveSettingsActivity" android:exported="false" />
        <activity android:name=".ui.MaintenanceActivity" android:exported="false" />
        <activity android:name=".ui.DiagnosisActivity" android:exported="false" />

        <!-- 备份导出：把 zip 通过系统分享面板交给用户（文件管理器 / 微信 / 邮件） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".SkipAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 保活：开机/升级兜底广播 + 15 分钟周期自检 Job -->
        <receiver
            android:name=".keepalive.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".keepalive.KeepAliveJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
