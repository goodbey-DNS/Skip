    <string name="keepalive_title">保活与后台</string>
    <string name="keepalive_mode_silent">静默复活已就绪：掉线 / 开机 / 升级后自动重新开启</string>
    <string name="keepalive_mode_notify">提醒模式：掉线时发通知提醒（不自动开启）</string>
    <string name="ka_mode_explain">静默复活需要电脑 adb 授权一次 WRITE_SECURE_SETTINGS（signature 级权限，正常安装拿不到），授权后本 App 才能把「自己的无障碍服务」写回系统设置并拉起。只保活大小姐自己——无法替其他 App 保活，那些应用的后台存活得靠它们自己的前台服务与厂商白名单机制。</string>
    <string name="keepalive_adb_hint">电脑连手机执行下面这条命令，升级为静默复活：</string>
    <string name="keepalive_cmd">adb shell pm grant com.noteatoranges.skipad android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="action_copy_cmd">复制授权命令</string>
    <string name="keepalive_copied">已复制，在电脑上执行即可</string>

